         <font>
            <Font name="Times New Roman" size="22.0" />
         </font>
      </Label>
      <Button fx:id="cadastrarBtn" layoutX="226.0" layoutY="92.0" mnemonicParsing="false" onMouseClicked="#cadastrar" text="Cadastrar novos Clientes" />
      <Button fx:id="verBtn" layoutX="227.0" layoutY="136.0" mnemonicParsing="false" onMouseClicked="#verClientes" text="Ver Clientes cadastrados" />
